SECRET_KEY=replace-with-a-long-random-secret

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
PROXY_HOST=127.0.0.1
PROXY_PORT=8081
BACKEND_URL=http://127.0.0.1:8080

DATABASE_URL=sqlite:///instance/firewall.sqlite3
ADMIN_USERNAME=admin
# Set one of these. ADMIN_PASSWORD_HASH is preferred for deployments.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CSRF_ENABLED=true
